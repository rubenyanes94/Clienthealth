# Copie a backend/.env para desarrollo local (o use `vercel env pull`). Nunca suba .env al repo.
ENVIRONMENT=development

# Neon (la integración de Vercel las inyecta). En local: Postgres del docker-compose.
DATABASE_URL=postgresql://app:app@localhost:5432/atencion
DATABASE_URL_UNPOOLED=

# 64+ caracteres aleatorios, distinto por entorno: python -c "import secrets;print(secrets.token_urlsafe(64))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=720

# WhatsApp Cloud API. Sin ACCESS_TOKEN/PHONE_NUMBER_ID funciona en modo simulación.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v23.0

# Copiloto (fase 2)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Vercel lo envía como "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=
TIMEZONE=America/Caracas

# Solo para `python -m app.seed`
ADMIN_EMAIL=
ADMIN_PASSWORD=
